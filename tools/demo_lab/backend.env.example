# DEMO-T1 — template for the local Demo Lab environment file.
#
# DO NOT commit a filled-in copy: it contains the lab service key and JWT secret.
# Generate the real file (outside the repository) with:
#
#     python3 tools/demo_lab/lab_env.py --write
#
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54426/carbontally_demo_local
SUPABASE_URL=http://127.0.0.1:54430
SUPABASE_SERVICE_KEY=<generated — see lab_env.py>
SUPABASE_ANON_KEY=<generated — see lab_env.py>
SUPABASE_JWT_SECRET=<generated — see lab_env.py>
TESSERACT_CMD=
