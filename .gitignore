# --- Temporary Diagnostic / Verification Artifacts ---
# Scratch/probe scripts, shell diagnostics, verification logs, and other
# transient debugging files created during development. Anchored to the repo
# root so _*.py / _*.txt never match legitimate package files (e.g. __init__.py).
/_*.py
/_*.txt
# Shell-redirect artifacts with mangled Windows drive-letter filenames
/d*carbon_ledger_*.txt
# Tool caches and coverage data from verification runs
.coverage
.pytest_cache/
.mypy_cache/
# One-off backend scratch file
/backend/test.txt
# --- Local Database / Recovery Backups ---
/backups/
/current_project_structure.txt
/local_backups/
# Local-only demo credentials (NEVER commit — contains local dev passwords)
/.local-demo-credentials.md

