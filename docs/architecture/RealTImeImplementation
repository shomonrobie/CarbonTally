Best Practices
1. Connection Management
javascript
// ✅ DO: Use singleton pattern
let instance = null;
export function getRealtimeManager() {
  if (!instance) {
    instance = new RealtimeManager();
  }
  return instance;
}

// ❌ DON'T: Create new instances
const manager1 = new RealtimeManager();
const manager2 = new RealtimeManager(); // ❌ Memory leak
2. Subscription Cleanup
javascript
// ✅ DO: Clean up subscriptions
useEffect(() => {
  const channel = supabase.channel('test');
  channel.subscribe();
  
  return () => {
    channel.unsubscribe();
  };
}, []);

// ❌ DON'T: Forget to unsubscribe
useEffect(() => {
  const channel = supabase.channel('test');
  channel.subscribe(); // ❌ Memory leak
}, []);
