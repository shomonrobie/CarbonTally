  },
  staff: {
    name: 'Staff',
    permissions: ['can_review', 'can_process'],
    canAccess: ['dashboard', 'reviews', 'assignments']
  },
  viewer: {
    name: 'Viewer',
    permissions: ['can_view'],
    canAccess: ['dashboard']
  }
};

// Role-based access check
function hasAccess(userRole, resource) {
  const role = ROLES[userRole];
  if (!role) return false;
  return role.canAccess.includes(resource);
}
