4. Frontend Connection Strategy
javascript
// 1. Initialize Supabase client
const supabase = createClient(url, key);

// 2. Connect to channels (only after authentication)
const channels = [];

async function connectChannels(user) {
    // Organization channel
    const orgChan = createOrgChannel(user.organization_id);
    channels.push(orgChan);
    
    // Staff channel (if user is staff)
    if (user.isStaff) {
        const staffChan = createStaffChannel(user.id);
        channels.push(staffChan);
    }
    
    // Conversation channels (for active chats)
    const activeConversations = await getActiveConversations(user.id);
    activeConversations.forEach(conv => {
        const convChan = createConversationChannel(conv.id);
        channels.push(convChan);
    });
    
    // Subscribe all
    await Promise.all(channels.map(c => c.subscribe()));
}

// 3. Cleanup on logout
function disconnectChannels() {
    channels.forEach(c => c.unsubscribe());
    channels = [];
}
