2. RLS Policies for Realtime
sql
-- Notifications: User can only see their own
CREATE POLICY "Users can see own notifications" ON notifications
    FOR SELECT USING (user_id = auth.uid());

-- Messages: Only conversation participants
CREATE POLICY "Can see messages in conversation" ON messages
    FOR SELECT USING (
        EXISTS (
            SELECT 1 FROM conversation_participants 
            WHERE conversation_id = messages.conversation_id 
            AND user_id = auth.uid()
        )
    );

-- Documents: Only organization members
CREATE POLICY "Org members see documents" ON customer_documents
    FOR SELECT USING (
        EXISTS (
            SELECT 1 FROM organization_members 
            WHERE organization_id = customer_documents.organization_id 
            AND user_id = auth.uid()
        )
    );
Backend Implementation
1. Realtime Manager (lib/realtime/manager.js)
javascript
// Core Realtime connection manager
class RealtimeManager {
  constructor() {
    this.supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    this.channels = new Map();
    this.eventDispatcher = new EventDispatcher();
    this.isConnected = false;
    this.user = null;
  }

  // Initialize with user data
  initialize(user) {
    this.user = user;
    this.supabase.auth.setSession({
      access_token: user.accessToken,
      refresh_token: user.refreshToken,
    });
  }

  // Connect to all channels
  async connect() {
    await this.connectOrganizationChannel(this.user.organization_id);
    
    if (this.user.isStaff) {
      await this.connectStaffChannel(this.user.id);
    }
    
    const conversations = await this.getActiveConversations();
    for (const conv of conversations) {
      await this.connectConversationChannel(conv.id);
    }
    
    this.isConnected = true;
  }
}
2. Channel Subscriptions
javascript
// Organization Channel
async connectOrganizationChannel(orgId) {
  const channel = this.supabase.channel(`org:${orgId}`);
  
  // Notifications
  channel.on('postgres_changes', {
    event: 'INSERT',
    schema: 'public',
    table: 'notifications',
    filter: `organization_id=eq.${orgId}`
  }, (payload) => {
    this.eventDispatcher.dispatch('NOTIFICATION_INSERT', payload);
  });

  // Document updates
  channel.on('postgres_changes', {
    event: 'UPDATE',
    schema: 'public',
    table: 'customer_documents',
    filter: `organization_id=eq.${orgId}`
  }, (payload) => {
    this.eventDispatcher.dispatch('DOCUMENT_UPDATE', payload);
  });

  // Verification updates
  channel.on('postgres_changes', {
    event: 'UPDATE',
    schema: 'public',
    table: 'customer_verifications',
    filter: `organization_id=eq.${orgId}`
  }, (payload) => {
    this.eventDispatcher.dispatch('VERIFICATION_UPDATE', payload);
  });

  // Activity feed
  channel.on('postgres_changes', {
    event: 'INSERT',
    schema: 'public',
    table: 'activity_feed',
    filter: `organization_id=eq.${orgId}`
  }, (payload) => {
    this.eventDispatcher.dispatch('ACTIVITY_INSERT', payload);
  });

  channel.subscribe();
  return channel;
}
Frontend Implementation
1. Realtime Context (context/RealtimeContext.jsx)
javascript
import React, { createContext, useContext, useEffect, useRef, useState } from 'react';
import { getRealtimeManager } from '../lib/realtime/manager';

const RealtimeContext = createContext(null);

export function RealtimeProvider({ children, user }) {
  const [isConnected, setIsConnected] = useState(false);
  const [onlineStaff, setOnlineStaff] = useState([]);
  const managerRef = useRef(null);

  useEffect(() => {
    if (!user) return;

    const manager = getRealtimeManager();
    managerRef.current = manager;
    
    manager.initialize(user);
    manager.connect();

    manager.on('CONNECTED', () => setIsConnected(true));
    manager.on('DISCONNECTED', () => setIsConnected(false));
    manager.on('PRESENCE_UPDATE', (payload) => {
      setOnlineStaff(payload.online);
    });

    return () => {
      manager.disconnect();
    };
  }, [user]);

  const value = {
    isConnected,
    onlineStaff,
    // ... other methods
  };

  return (
    <RealtimeContext.Provider value={value}>
      {children}
    </RealtimeContext.Provider>
  );
}

export const useRealtime = () => {
  const context = useContext(RealtimeContext);
  if (!context) {
    throw new Error('useRealtime must be used within RealtimeProvider');
  }
  return context;
};
2. Notification Hook
javascript
// hooks/useNotifications.js
export function useNotifications() {
  const { on, off } = useRealtime();
  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);

  useEffect(() => {
    const handleInsert = (payload) => {
      setNotifications(prev => [payload.new, ...prev]);
      if (!payload.new.is_read) {
        setUnreadCount(prev => prev + 1);
        showNotification(payload.new);
      }
    };

    on('NOTIFICATION_INSERT', handleInsert);
    return () => off('NOTIFICATION_INSERT', handleInsert);
  }, [on, off]);

  return { notifications, unreadCount };
}
