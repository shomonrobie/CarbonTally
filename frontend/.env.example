# CarbonTally frontend build-time configuration (Create React App).
# Copy to .env.local for local work, and set the same keys in the host
# (Vercel) build environment. Only REACT_APP_* keys reach the browser.

# Backend API origin
REACT_APP_API_URL=http://localhost:8000

# Supabase
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Google OAuth
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_OAUTH_REDIRECT_URL=

# PostHog product analytics.
# Without REACT_APP_PUBLIC_POSTHOG_KEY the SDK stays off and no events are sent.
# Use the EU host to match the CarbonTally PostHog project.
REACT_APP_PUBLIC_POSTHOG_KEY=
REACT_APP_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
