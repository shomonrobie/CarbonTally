/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model verification_logs {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id         String         @db.Uuid
  verified_by         String         @db.Uuid
  verified_at         DateTime?      @default(now()) @db.Timestamptz(6)
  verification_status String         @db.VarChar(20)
  verification_notes  String?
  verification_data   Json?
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  staff_profiles      staff_profiles @relation(fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([document_id], map: "idx_verification_logs_document")
  @@schema("public")
}

model waitlist {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  full_name     String?
  company_name  String?
  company_size  String?
  interested_in String?
  source        String?   @default("landing_page")
  status        String?   @default("pending")
  invited_at    DateTime? @db.Timestamptz(6)
  activated_at  DateTime? @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_waitlist_created")
  @@index([email], map: "idx_waitlist_email")
  @@index([status], map: "idx_waitlist_status")
  @@schema("public")
}

