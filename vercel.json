{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/(.*\\..*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
